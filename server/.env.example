# Trại Gà — cấu hình server. Chép thành .env (deploy\windows\setup.ps1 tự làm việc này).
# File .env KHÔNG được commit (.gitignore đã chặn).

# --- Cloudflare Tunnel: CHỈ cần điền dòng này ---
# Cloudflare Zero Trust → Networks → Tunnels → Create tunnel (Cloudflared) → copy token sau "--token"
CLOUDFLARE_TUNNEL_TOKEN=

# --- Server (để mặc định là chạy) ---
PORT=8787
ADMIN_PORT=8788
# chỉ nghe trên máy này; cloudflared nối vào localhost
HOST=127.0.0.1
DB_PATH=data/farm.db
# bí mật ký số ngẫu nhiên phía server — setup.ps1 tự sinh, ĐỪNG đổi khi đã có người chơi
SERVER_SECRET=
# để trống = mặc định (game.vuducan.qzz.io, vuducan.qzz.io, da0ran9e.github.io, localhost)
ALLOWED_ORIGINS=
# 1 = server phục vụ luôn trang game ở "/" (người chơi chỉ cần mở https://game.vuducan.qzz.io/)
SERVE_CLIENT=1
