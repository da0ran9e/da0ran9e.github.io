{
  "name": "trai-ga-server",
  "private": true,
  "type": "module",
  "description": "Trại Gà — server có thẩm quyền (M2: HTTP/JSON). Không có phụ thuộc npm.",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/main.mjs",
